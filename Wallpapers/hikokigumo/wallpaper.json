{
  "id": "hikokigumo",
  "name": "Contrails",
  "title": "飛行機雲",
  "description": "Contrails drawing slowly across an evening sky over a distant skyline, a red lattice tower and Mount Fuji, with tiled rooftops and a utility pole in front. Colours follow your clock from blue to orange.",
  "entry": "index.html",
  "version": 1,
  "properties": [
    {"key": "time", "label": "time of day", "type": "choice", "options": ["auto", "dawn", "day", "dusk", "night"], "default": "dusk"},
    {"key": "trails", "label": "contrails", "type": "range", "min": 0, "max": 2, "step": 0.1, "default": 1},
    {"key": "planes", "label": "aircraft", "type": "toggle", "default": true},
    {"key": "mode", "label": "weave", "type": "choice", "options": ["glyph", "block", "dot"], "default": "glyph"},
    {"key": "ramp", "label": "glyphs", "type": "choice", "options": ["lines", "ascii", "kana", "dense"], "default": "lines"},
    {"key": "cell", "label": "cell size", "type": "range", "min": 4, "max": 24, "step": 1, "default": 7},
    {"key": "speed", "label": "speed", "type": "range", "min": 0.1, "max": 3, "step": 0.1, "default": 1}
  ]
}
