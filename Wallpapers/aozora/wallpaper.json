{
  "id": "aozora",
  "name": "Aozora",
  "title": "青空",
  "description": "A clear blue sky with slow white clouds over a quiet street of tiled roofs. A power line sways gently from its pole, and the light follows your clock.",
  "entry": "index.html",
  "version": 1,
  "properties": [
    {"key": "time", "label": "time of day", "type": "choice", "options": ["auto", "dawn", "day", "dusk", "night"], "default": "day"},
    {"key": "clouds", "label": "clouds", "type": "range", "min": 0, "max": 2, "step": 0.1, "default": 1},
    {"key": "sway", "label": "power line sway", "type": "toggle", "default": true},
    {"key": "mode", "label": "weave", "type": "choice", "options": ["glyph", "block", "dot"], "default": "glyph"},
    {"key": "ramp", "label": "glyphs", "type": "choice", "options": ["lines", "ascii", "kana", "dense"], "default": "lines"},
    {"key": "cell", "label": "cell size", "type": "range", "min": 4, "max": 24, "step": 1, "default": 7},
    {"key": "speed", "label": "speed", "type": "range", "min": 0.1, "max": 3, "step": 0.1, "default": 1}
  ]
}
