{
  "id": "nami",
  "name": "Nami",
  "title": "青海波",
  "description": "The overlapping-scale wave pattern, breathing like a real sea as long swells roll under it.",
  "entry": "index.html",
  "version": 1,
  "properties": [
    {"key": "ink", "label": "ink", "type": "choice", "options": ["ai", "sumi", "shu", "moss"], "default": "ai"},
    {"key": "swell", "label": "swell", "type": "range", "min": 0.2, "max": 3, "step": 0.1, "default": 1},
    {"key": "mode", "label": "weave", "type": "choice", "options": ["glyph", "block", "dot", "raw"], "default": "glyph"},
    {"key": "ramp", "label": "glyphs", "type": "choice", "options": ["lines", "ascii", "kana", "dense"], "default": "lines"},
    {"key": "cell", "label": "cell size", "type": "range", "min": 4, "max": 24, "step": 1, "default": 7},
    {"key": "speed", "label": "speed", "type": "range", "min": 0.1, "max": 3, "step": 0.1, "default": 1}
  ]
}
