{
  "id": "chashitsu",
  "name": "Tea hut",
  "title": "茶室",
  "description": "A thatched tea hut deep in a mossy cedar forest. Steam curls from the roof vent, a stepping-stone path leads to the low door, light shafts drift through the trees, and the light follows your clock.",
  "entry": "index.html",
  "version": 1,
  "properties": [
    {"key": "time", "label": "time of day", "type": "choice", "options": ["auto", "dawn", "day", "dusk", "night"], "default": "auto"},
    {"key": "smoke", "label": "steam", "type": "range", "min": 0, "max": 2, "step": 0.1, "default": 1},
    {"key": "light", "label": "light shafts", "type": "range", "min": 0, "max": 2, "step": 0.1, "default": 1},
    {"key": "leaves", "label": "maple leaves", "type": "toggle", "default": true},
    {"key": "mode", "label": "weave", "type": "choice", "options": ["glyph", "block", "dot"], "default": "glyph"},
    {"key": "ramp", "label": "glyphs", "type": "choice", "options": ["lines", "ascii", "kana", "dense"], "default": "lines"},
    {"key": "cell", "label": "cell size", "type": "range", "min": 4, "max": 24, "step": 1, "default": 7},
    {"key": "speed", "label": "speed", "type": "range", "min": 0.1, "max": 3, "step": 0.1, "default": 1}
  ]
}
