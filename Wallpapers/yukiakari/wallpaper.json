{
  "id": "yukiakari",
  "name": "Snowlight",
  "title": "雪明かり",
  "description": "A snow village at night, steep thatched farmhouses glowing from within while the snow itself lights the dark. Slow flakes fall, smoke rises, and the sky follows your clock.",
  "entry": "index.html",
  "version": 1,
  "properties": [
    {"key": "time", "label": "time of day", "type": "choice", "options": ["auto", "dawn", "day", "dusk", "night"], "default": "auto"},
    {"key": "snowfall", "label": "snowfall", "type": "range", "min": 0, "max": 2, "step": 0.1, "default": 1},
    {"key": "smoke", "label": "hearth smoke", "type": "toggle", "default": true},
    {"key": "mode", "label": "weave", "type": "choice", "options": ["glyph", "block", "dot"], "default": "glyph"},
    {"key": "ramp", "label": "glyphs", "type": "choice", "options": ["lines", "ascii", "kana", "dense"], "default": "lines"},
    {"key": "cell", "label": "cell size", "type": "range", "min": 4, "max": 24, "step": 1, "default": 7},
    {"key": "speed", "label": "speed", "type": "range", "min": 0.1, "max": 3, "step": 0.1, "default": 1}
  ]
}
