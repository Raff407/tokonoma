{
  "id": "torii",
  "name": "Torii",
  "title": "鳥居",
  "description": "A shrine gate at the top of mossy steps. The sky keeps your clock, the trees keep the month, a fox keeps watch.",
  "entry": "index.html",
  "version": 1,
  "properties": [
    { "key": "season", "label": "season", "type": "choice", "options": ["auto", "spring", "summer", "autumn", "winter"], "default": "auto" },
    { "key": "time", "label": "time of day", "type": "choice", "options": ["auto", "dawn", "day", "dusk", "night"], "default": "auto" },
    { "key": "leaves", "label": "falling", "type": "range", "min": 0, "max": 2, "step": 0.1, "default": 1 },
    { "key": "wind", "label": "wind", "type": "range", "min": 0, "max": 2.5, "step": 0.1, "default": 1 },
    { "key": "fox", "label": "fox", "type": "toggle", "default": true },
    { "key": "mode", "label": "weave", "type": "choice", "options": ["glyph", "block", "dot"], "default": "glyph" },
    { "key": "ramp", "label": "glyphs", "type": "choice", "options": ["lines", "ascii", "kana", "dense"], "default": "lines" },
    { "key": "cell", "label": "cell size", "type": "range", "min": 4, "max": 24, "step": 1, "default": 9 },
    { "key": "speed", "label": "speed", "type": "range", "min": 0.1, "max": 3, "step": 0.1, "default": 1 }
  ]
}
