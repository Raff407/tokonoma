{
  "id": "tokonoma",
  "name": "Alcove",
  "title": "床の間",
  "description": "A tokonoma alcove in a tatami room: a hanging scroll of misty mountains, camellias in a bronze vase, incense smoke rising, and window light that crosses the tatami with your clock.",
  "entry": "index.html",
  "version": 1,
  "properties": [
    {"key": "time", "label": "time of day", "type": "choice", "options": ["auto", "dawn", "day", "dusk", "night"], "default": "auto"},
    {"key": "light", "label": "window light", "type": "range", "min": 0, "max": 2, "step": 0.1, "default": 1},
    {"key": "smoke", "label": "incense", "type": "range", "min": 0, "max": 2, "step": 0.1, "default": 1},
    {"key": "mode", "label": "weave", "type": "choice", "options": ["glyph", "block", "dot"], "default": "glyph"},
    {"key": "ramp", "label": "glyphs", "type": "choice", "options": ["lines", "ascii", "kana", "dense"], "default": "lines"},
    {"key": "cell", "label": "cell size", "type": "range", "min": 4, "max": 24, "step": 1, "default": 7},
    {"key": "speed", "label": "speed", "type": "range", "min": 0.1, "max": 3, "step": 0.1, "default": 1}
  ]
}
