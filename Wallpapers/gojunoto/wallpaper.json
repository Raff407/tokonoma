{
  "id": "gojunoto",
  "name": "Gojunoto",
  "title": "五重塔",
  "description": "A five-storey pagoda on a wooded hill, under your clock. Cloud drifts behind and in front of it, birds circle the spire, and lamps come on along its eaves after dark.",
