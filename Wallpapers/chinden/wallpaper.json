{
  "id": "chinden",
  "name": "Chinden",
  "title": "路面電車",
  "description": "A small old streetcar rattles along a quiet tree-lined track at dusk, past low tiled houses and a stone wall, under overhead wires. The lamps come on as the light follows your clock, and ginkgo leaves drift down.",
  "entry": "index.html",
  "version": 1,
  "properties": [
    {"key": "time", "label": "time of day", "type": "choice", "options": ["auto", "dawn", "day", "dusk", "night"], "default": "dusk"},
    {"key": "clouds", "label": "clouds", "type": "range", "min": 0, "max": 2, "step": 0.1, "default": 1},
    {"key": "leaves", "label": "falling leaves", "type": "range", "min": 0, "max": 2, "step": 0.1, "default": 1},
    {"key": "mode", "label": "weave", "type": "choice", "options": ["glyph", "block", "dot"], "default": "glyph"},
    {"key": "ramp", "label": "glyphs", "type": "choice", "options": ["lines", "ascii", "kana", "dense"], "default": "lines"},
    {"key": "cell", "label": "cell size", "type": "range", "min": 4, "max": 24, "step": 1, "default": 7},
    {"key": "speed", "label": "speed", "type": "range", "min": 0.1, "max": 3, "step": 0.1, "default": 1}
  ]
}
