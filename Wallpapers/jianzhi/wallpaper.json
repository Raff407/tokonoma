{
  "id": "jianzhi",
  "name": "Paper-cut Window",
  "title": "剪纸",
  "culture": "chinese",
  "description": "Red paper-cut flowers pasted on a lattice window, peony, plum and chrysanthemum. The light behind the paper breathes slowly warmer and cooler.",
  "entry": "index.html",
