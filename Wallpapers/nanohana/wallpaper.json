{
  "id": "nanohana",
  "name": "Nanohana",
  "title": "菜の花",
  "description": "Rapeseed fields in full flower below a railway embankment. A small two-car local train rattles across now and then, the flowers sway, clouds drift by and the light follows your clock.",
  "entry": "index.html",
  "version": 1,
  "properties": [
    {"key": "time", "label": "time of day", "type": "choice", "options": ["auto", "dawn", "day", "dusk", "night"], "default": "auto"},
    {"key": "breeze", "label": "breeze", "type": "range", "min": 0, "max": 2, "step": 0.1, "default": 1},
    {"key": "trains", "label": "trains", "type": "toggle", "default": true},
    {"key": "mode", "label": "weave", "type": "choice", "options": ["glyph", "block", "dot"], "default": "glyph"},
    {"key": "ramp", "label": "glyphs", "type": "choice", "options": ["lines", "ascii", "kana", "dense"], "default": "lines"},
    {"key": "cell", "label": "cell size", "type": "range", "min": 4, "max": 24, "step": 1, "default": 7},
    {"key": "speed", "label": "speed", "type": "range", "min": 0.1, "max": 3, "step": 0.1, "default": 1}
  ]
}
