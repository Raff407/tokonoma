{
  "id": "hoshi",
  "name": "Hoshi",
  "title": "星",
  "description": "The whole sky turning around the pole star over a dark ridge. The Milky Way goes with it, and a slow meteor now and then.",
  "entry": "index.html",
  "version": 1,
  "properties": [
    {"key": "stars", "label": "stars", "type": "range", "min": 0.3, "max": 1.5, "step": 0.1, "default": 1},
    {"key": "turn", "label": "turning", "type": "range", "min": 0, "max": 5, "step": 0.1, "default": 1},
    {"key": "meteors", "label": "meteors", "type": "toggle", "default": true},
    {"key": "mode", "label": "weave", "type": "choice", "options": ["glyph", "block", "dot", "raw"], "default": "glyph"},
    {"key": "ramp", "label": "glyphs", "type": "choice", "options": ["lines", "ascii", "kana", "dense"], "default": "lines"},
    {"key": "cell", "label": "cell size", "type": "range", "min": 4, "max": 24, "step": 1, "default": 7},
    {"key": "speed", "label": "speed", "type": "range", "min": 0.1, "max": 3, "step": 0.1, "default": 1}
  ]
}
