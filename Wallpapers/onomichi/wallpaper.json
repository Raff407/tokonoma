{
  "id": "onomichi",
  "name": "Onomichi",
  "title": "尾道",
  "description": "A hillside of temple roofs and stone stairs above a narrow strait. A ferry crosses the water, the lamps come on one by one, and the light follows your clock.",
  "entry": "index.html",
  "version": 1,
