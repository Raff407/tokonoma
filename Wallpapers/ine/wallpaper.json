{
  "id": "ine",
  "name": "Ine",
  "title": "伊根",
  "description": "A bay of wooden boathouses built right over the water. The sea lies still, small boats rock at their slips, hills stand behind, and the light follows your clock.",
  "entry": "index.html",
  "version": 1,
  "properties": [
    {"key": "time", "label": "time of day", "type": "choice", "options": ["auto", "dawn", "day", "dusk", "night"], "default": "auto"},
