{
  "id": "kaze",
  "name": "Kaze",
  "title": "風",
  "description": "A sword left standing in silver grass under a storm. Gusts roll across the field; the grass parts for your cursor and a click sends a gust out.",
  "entry": "index.html",
  "version": 1,
  "interactive": true,
  "properties": [
    { "key": "wind", "label": "wind", "type": "range", "min": 0, "max": 2.5, "step": 0.1, "default": 1 },
    { "key": "fluff", "label": "drifting seeds", "type": "range", "min": 0, "max": 2, "step": 0.1, "default": 1 },
    { "key": "sword", "label": "sword", "type": "toggle", "default": true },
    { "key": "mode", "label": "weave", "type": "choice", "options": ["glyph", "block", "dot", "raw"], "default": "glyph" },
    { "key": "ramp", "label": "glyphs", "type": "choice", "options": ["lines", "ascii", "kana", "dense"], "default": "lines" },
    { "key": "cell", "label": "cell size", "type": "range", "min": 4, "max": 20, "step": 1, "default": 8 },
    { "key": "speed", "label": "speed", "type": "range", "min": 0.1, "max": 3, "step": 0.1, "default": 1 }
  ]
}
