{
  "id": "fuji",
  "name": "Fuji",
  "title": "富士",
  "description": "The mountain over a still lake. Sun and moon keep your clock, clouds drift across, a pagoda watches from the shore.",
  "entry": "index.html",
  "version": 1,
  "properties": [
    { "key": "time", "label": "time of day", "type": "choice", "options": ["auto", "dawn", "day", "dusk", "night"], "default": "auto" },
    { "key": "clouds", "label": "clouds", "type": "range", "min": 0, "max": 2, "step": 0.1, "default": 1 },
    { "key": "ripple", "label": "ripple", "type": "range", "min": 0, "max": 3, "step": 0.1, "default": 1 },
    { "key": "mode", "label": "weave", "type": "choice", "options": ["glyph", "block", "dot", "raw"], "default": "glyph" },
    { "key": "ramp", "label": "glyphs", "type": "choice", "options": ["lines", "ascii", "kana", "dense"], "default": "lines" },
    { "key": "cell", "label": "cell size", "type": "range", "min": 4, "max": 24, "step": 1, "default": 9 },
    { "key": "speed", "label": "speed", "type": "range", "min": 0.1, "max": 3, "step": 0.1, "default": 1 }
  ]
}
