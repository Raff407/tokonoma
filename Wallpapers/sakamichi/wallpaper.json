{
  "id": "sakamichi",
  "name": "Sakamichi",
  "title": "坂道",
  "description": "A steep street of a seaside town running down to the sea, with a small train crossing at the bottom. The sea glitters, clouds drift, the train comes by now and then, and the light follows your clock.",
  "entry": "index.html",
  "version": 1,
  "properties": [
    {"key": "time", "label": "time of day", "type": "choice", "options": ["auto", "dawn", "day", "dusk", "night"], "default": "auto"},
    {"key": "train", "label": "train", "type": "toggle", "default": true},
    {"key": "glitter", "label": "sea glitter", "type": "range", "min": 0, "max": 2, "step": 0.1, "default": 1},
    {"key": "mode", "label": "weave", "type": "choice", "options": ["glyph", "block", "dot"], "default": "glyph"},
    {"key": "ramp", "label": "glyphs", "type": "choice", "options": ["lines", "ascii", "kana", "dense"], "default": "lines"},
    {"key": "cell", "label": "cell size", "type": "range", "min": 4, "max": 24, "step": 1, "default": 7},
    {"key": "speed", "label": "speed", "type": "range", "min": 0.1, "max": 3, "step": 0.1, "default": 1}
  ]
}
