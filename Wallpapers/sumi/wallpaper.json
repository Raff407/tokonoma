{
  "id": "sumi",
  "name": "Sumi",
  "title": "墨流し",
  "description": "Ink floated on still water and lifted onto washi. Rings keep landing, a slow current folds them, your cursor combs the surface.",
  "entry": "index.html",
  "version": 1,
  "interactive": true,
  "properties": [
    { "key": "inks", "label": "inks", "type": "choice", "options": ["ai", "sumi", "beni", "mixed"], "default": "ai" },
    { "key": "pace", "label": "drops per second", "type": "range", "min": 0.1, "max": 4, "step": 0.1, "default": 1 },
    { "key": "swirl", "label": "current", "type": "range", "min": 0, "max": 3, "step": 0.1, "default": 1 },
    { "key": "size", "label": "drop size", "type": "range", "min": 0.4, "max": 2.5, "step": 0.1, "default": 1 },
    { "key": "mode", "label": "weave", "type": "choice", "options": ["glyph", "dot", "block", "raw"], "default": "glyph" },
    { "key": "ramp", "label": "glyphs", "type": "choice", "options": ["kana", "ascii", "lines", "dense"], "default": "kana" },
    { "key": "cell", "label": "cell size", "type": "range", "min": 3, "max": 24, "step": 1, "default": 8 },
    { "key": "speed", "label": "speed", "type": "range", "min": 0.1, "max": 3, "step": 0.1, "default": 1 }
  ]
}
