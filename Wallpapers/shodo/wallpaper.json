{
  "id": "shodo",
  "name": "Shodo",
  "title": "書道",
  "description": "Brushwork on washi. Sweeps, hooks and open circles of ink are laid down slowly, rest a while, then soak away into the paper. Shapes only, never words.",
  "entry": "index.html",
  "version": 1,
  "properties": [
    {"key": "strokes", "label": "strokes", "type": "range", "min": 0.3, "max": 2, "step": 0.1, "default": 1},
    {"key": "linger", "label": "linger", "type": "range", "min": 0.3, "max": 3, "step": 0.1, "default": 1},
    {"key": "seal", "label": "seal", "type": "toggle", "default": true},
    {"key": "mode", "label": "weave", "type": "choice", "options": ["glyph", "block", "dot"], "default": "glyph"},
    {"key": "ramp", "label": "glyphs", "type": "choice", "options": ["lines", "ascii", "kana", "dense"], "default": "lines"},
    {"key": "cell", "label": "cell size", "type": "range", "min": 4, "max": 24, "step": 1, "default": 7},
    {"key": "speed", "label": "speed", "type": "range", "min": 0.1, "max": 3, "step": 0.1, "default": 1}
  ]
}
