{
  "id": "chengqiang",
  "name": "City Wall",
  "title": "城墙",
  "culture": "chinese",
  "description": "An old brick city wall at dusk with its double-roofed gate tower. Rows of red lanterns sway and glow as the light follows your clock, clouds drift and a few swallows cross the sky.",
  "entry": "index.html",
  "version": 1,
  "properties": [
    {"key": "time", "label": "time of day", "type": "choice", "options": ["auto", "dawn", "day", "dusk", "night"], "default": "auto"},
    {"key": "glow", "label": "lantern glow", "type": "range", "min": 0, "max": 2, "step": 0.1, "default": 1},
    {"key": "clouds", "label": "clouds", "type": "range", "min": 0, "max": 2, "step": 0.1, "default": 1},
    {"key": "birds", "label": "swallows", "type": "toggle", "default": true},
    {"key": "mode", "label": "weave", "type": "choice", "options": ["glyph", "block", "dot"], "default": "glyph"},
    {"key": "ramp", "label": "glyphs", "type": "choice", "options": ["lines", "ascii", "kana", "dense"], "default": "lines"},
    {"key": "cell", "label": "cell size", "type": "range", "min": 4, "max": 24, "step": 1, "default": 7},
    {"key": "speed", "label": "speed", "type": "range", "min": 0.1, "max": 3, "step": 0.1, "default": 1}
  ]
}
