{
  "id": "natsuyasumi",
  "name": "Natsuyasumi",
  "title": "夏休み",
  "description": "A country road in the summer holidays. A huge cumulus tower over green rice paddies, utility poles and sagging wires, sunflowers by the verge, heat shimmering off the asphalt, light that follows your clock.",
  "entry": "index.html",
  "version": 1,
  "properties": [
    {"key": "time", "label": "time of day", "type": "choice", "options": ["auto", "dawn", "day", "dusk", "night"], "default": "auto"},
    {"key": "heat", "label": "heat shimmer", "type": "range", "min": 0, "max": 2, "step": 0.1, "default": 1},
    {"key": "wind", "label": "wind in the rice", "type": "toggle", "default": true},
    {"key": "mode", "label": "weave", "type": "choice", "options": ["glyph", "block", "dot"], "default": "glyph"},
    {"key": "ramp", "label": "glyphs", "type": "choice", "options": ["lines", "ascii", "kana", "dense"], "default": "lines"},
    {"key": "cell", "label": "cell size", "type": "range", "min": 4, "max": 24, "step": 1, "default": 7},
    {"key": "speed", "label": "speed", "type": "range", "min": 0.1, "max": 3, "step": 0.1, "default": 1}
  ]
}
