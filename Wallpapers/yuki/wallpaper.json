{
  "id": "yuki",
  "name": "Yuki",
  "title": "雪",
  "description": "A mountain village at night under falling snow. Windows glow and go out one by one, chimney smoke leans with the wind.",
  "entry": "index.html",
  "version": 1,
  "properties": [
    {"key": "snow", "label": "snow", "type": "range", "min": 0, "max": 3, "step": 0.1, "default": 1},
    {"key": "wind", "label": "wind", "type": "range", "min": -2, "max": 3, "step": 0.1, "default": 1},
    {"key": "mode", "label": "weave", "type": "choice", "options": ["glyph", "block", "dot"], "default": "glyph"},
    {"key": "ramp", "label": "glyphs", "type": "choice", "options": ["lines", "ascii", "kana", "dense"], "default": "lines"},
    {"key": "cell", "label": "cell size", "type": "range", "min": 4, "max": 24, "step": 1, "default": 8},
    {"key": "speed", "label": "speed", "type": "range", "min": 0.1, "max": 3, "step": 0.1, "default": 1}
  ]
}
