{
  "id": "tatami",
  "name": "Tatami",
  "title": "畳",
  "description": "A tatami room with paper sliding doors. A patch of sunlight crosses the woven mats with the hour, dust turns slowly in the beam, a bamboo shadow sways on the paper and a bowl of tea steams on its tray.",
  "entry": "index.html",
  "version": 1,
  "properties": [
    {"key": "time", "label": "time of day", "type": "choice", "options": ["auto", "dawn", "day", "dusk", "night"], "default": "auto"},
    {"key": "dust", "label": "dust in the beam", "type": "range", "min": 0, "max": 2, "step": 0.1, "default": 1},
    {"key": "shadows", "label": "bamboo shadow", "type": "toggle", "default": true},
    {"key": "mode", "label": "weave", "type": "choice", "options": ["glyph", "block", "dot"], "default": "glyph"},
    {"key": "ramp", "label": "glyphs", "type": "choice", "options": ["lines", "ascii", "kana", "dense"], "default": "lines"},
    {"key": "cell", "label": "cell size", "type": "range", "min": 4, "max": 24, "step": 1, "default": 7},
    {"key": "speed", "label": "speed", "type": "range", "min": 0.1, "max": 3, "step": 0.1, "default": 1}
  ]
}
